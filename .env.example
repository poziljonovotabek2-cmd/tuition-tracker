POSTGRES_DB=tuition
POSTGRES_USER=tuition
POSTGRES_PASSWORD=replace-with-a-strong-password
# For local Python startup. Compose sets the hostname to db automatically.
DATABASE_URL=postgresql+psycopg://tuition:replace-with-a-strong-password@localhost:5432/tuition
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=replace-with-random-key-at-least-24-characters
BOT_TOKEN=
# Optional Telegram user IDs; used only to format the /id response.
ADMIN_TELEGRAM_IDS=
API_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Tashkent
